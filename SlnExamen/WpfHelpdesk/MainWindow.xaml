<Window x:Class="WpfHelpdesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Helpdesk Tickets"
        MinWidth="1000" MinHeight="650"
        Padding="8">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <!-- Top area: two columns -->
            <RowDefinition Height="*"/>
            <!-- Bottom area: new ticket + error -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP: two equal columns -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Filters + Tickets -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <GroupBox Header="Filters" Grid.Row="0" Padding="8" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="Prioriteit" FontWeight="Bold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cmbPrioriteitFilter" SelectionChanged="FilterGewijzigd" Margin="0,0,0,8"/>

                        <TextBlock Text="Melder" FontWeight="Bold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cmbMelderFilter" SelectionChanged="FilterGewijzigd" Margin="0,0,0,8"/>

                        <CheckBox x:Name="chkAlleenOpen" Content="Alleen open tickets" Checked="FilterGewijzigd" Unchecked="FilterGewijzigd"/>
                    </StackPanel>
                </GroupBox>

                <StackPanel Grid.Row="1" Margin="0,0,8,0">
                    <TextBlock Text="Tickets" FontWeight="Bold" Margin="0,0,0,4"/>
                    <ListBox x:Name="lstTickets" SelectionChanged="LstTickets_SelectionChanged" VerticalAlignment="Stretch"/>
                </StackPanel>
            </Grid>

            <!-- RIGHT COLUMN: Details + close button -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Details" FontWeight="Bold" Margin="0,0,0,6"/>

                <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Padding="8" Background="White">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="txtDetails" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13"/>
                    </ScrollViewer>
                </Border>

                <Button x:Name="btnAfsluiten" Grid.Row="2" Content="Ticket afsluiten" Height="34" Margin="0,8,0,0" Click="BtnAfsluiten_Click" HorizontalAlignment="Stretch"/>
            </Grid>
        </Grid>

        <!-- BOTTOM: Nieuw ticket + foutmelding -->
        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,8,0,0">
            <GroupBox Header="Nieuw ticket" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Titel -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Titel:" VerticalAlignment="Center" Margin="0,4,8,4"/>
                    <TextBox x:Name="txtTitel" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,4,0,4" Height="26"/>

                    <!-- Melder / Prioriteit -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Melder:" VerticalAlignment="Center" Margin="0,4,8,4"/>
                    <ComboBox x:Name="cmbMelderNieuw" Grid.Row="1" Grid.Column="1" Margin="0,4,12,4" Height="26"/>

                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Prioriteit:" VerticalAlignment="Center" Margin="0,4,8,4"/>
                    <ComboBox x:Name="cmbPrioriteitNieuw" Grid.Row="1" Grid.Column="3" Margin="0,4,0,4" Height="26"/>

                    <!-- Type / Extra -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Type:" VerticalAlignment="Center" Margin="0,4,8,4"/>
                    <ComboBox x:Name="cmbType" Grid.Row="2" Grid.Column="1" Margin="0,4,12,4" Height="26" SelectionChanged="CmbType_SelectionChanged">
                        <ComboBoxItem Content="Hardware"/>
                        <ComboBoxItem Content="Software"/>
                    </ComboBox>

                    <TextBlock x:Name="lblExtraInfo" Grid.Row="2" Grid.Column="2" Text="Toestel:" VerticalAlignment="Center" Margin="0,4,8,4"/>
                    <TextBox x:Name="txtExtraInfo" Grid.Row="2" Grid.Column="3" Margin="0,4,0,4" Height="26"/>

                    <!-- Toevoegen knop -->
                    <Button x:Name="btnToevoegen" Grid.Row="3" Grid.Column="3" Content="Toevoegen" Height="28" Margin="0,6,0,0" HorizontalAlignment="Right" Click="BtnToevoegen_Click"/>
                </Grid>
            </GroupBox>

            <TextBlock x:Name="txtFout" Foreground="Red" TextWrapping="Wrap" Margin="4,6,0,0"/>
        </StackPanel>
    </Grid>
</Window>
