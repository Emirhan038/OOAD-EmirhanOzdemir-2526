<Page x:Class="DokterApp.PatientVerwijderenPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Patiënt – Verwijderen">

    <StackPanel Margin="40,40,40,40" MaxWidth="520" HorizontalAlignment="Left">

        <!-- Terug-knop -->
        <Button x:Name="BtnTerug" Content="← Terug naar overzicht"
                Click="BtnTerug_Click"
                HorizontalAlignment="Left"
                Padding="14,7" Margin="0,0,0,24"
                Background="#7F8C8D" Foreground="White"
                BorderThickness="0" FontSize="13" Cursor="Hand"/>

        <!-- Waarschuwingstitel -->
        <TextBlock Text="Patiënt verwijderen" FontSize="22" FontWeight="Bold"
                   Foreground="#C0392B" Margin="0,0,0,16"/>

        <!-- Naam van de te verwijderen patiënt -->
        <TextBlock x:Name="TxtPatientNaam" FontSize="16" Foreground="#2C3E50"
                   Margin="0,0,0,12" TextWrapping="Wrap"/>

        <!-- Bevestigingsvraag — nooit een MessageBox -->
        <Border Background="#FADBD8" CornerRadius="6" Padding="18,14" Margin="0,0,0,24">
            <TextBlock FontSize="14" Foreground="#922B21" TextWrapping="Wrap" LineHeight="24">
                Weet u zeker dat u deze patiënt wilt verwijderen?
                Deze actie verwijdert ook alle gekoppelde afspraken en kan niet ongedaan worden gemaakt.
            </TextBlock>
        </Border>

        <!-- Foutmelding -->
        <TextBlock x:Name="TxtFout" Foreground="#C0392B" FontSize="13"
                   TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed"/>

        <!-- Ja / Nee knoppen — in-page bevestiging, nooit een MessageBox -->
        <StackPanel Orientation="Horizontal">
            <Button x:Name="BtnJa" Content="Ja, verwijderen"
                    Click="BtnJa_Click"
                    Padding="18,10" Margin="0,0,12,0"
                    Background="#E74C3C" Foreground="White"
                    BorderThickness="0" FontSize="14" Cursor="Hand"/>
            <Button x:Name="BtnNee" Content="Nee, annuleren"
                    Click="BtnNee_Click"
                    Padding="18,10"
                    Background="#566573" Foreground="White"
                    BorderThickness="0" FontSize="14" Cursor="Hand"/>
        </StackPanel>

    </StackPanel>
</Page>
