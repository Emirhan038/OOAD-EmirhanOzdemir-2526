<Page x:Class="DokterApp.PatientFormPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Patiënt – Formulier">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,24,40,40" MaxWidth="600" HorizontalAlignment="Left">

            <!-- Terug-knop -->
            <Button x:Name="BtnTerug" Content="← Terug naar overzicht"
                    Click="BtnTerug_Click"
                    HorizontalAlignment="Left"
                    Padding="14,7" Margin="0,0,0,20"
                    Background="#7F8C8D" Foreground="White"
                    BorderThickness="0" FontSize="13" Cursor="Hand"/>

            <!-- Titel: "Nieuwe patiënt" of "Patiënt wijzigen" — ingesteld in code -->
            <TextBlock x:Name="TxtTitel" FontSize="22" FontWeight="Bold"
                       Foreground="#2C3E50" Margin="0,0,0,24" TextWrapping="Wrap"/>

            <!-- ── Voornaam ──────────────────────────────────────────────────── -->
            <TextBlock Text="Voornaam *" FontSize="13" Foreground="#566573" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtVoornaam" FontSize="14" Padding="10,7"
                     BorderBrush="#BDC3C7" BorderThickness="1" Margin="0,0,0,14"/>

            <!-- ── Achternaam ─────────────────────────────────────────────────── -->
            <TextBlock Text="Achternaam *" FontSize="13" Foreground="#566573" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtAchternaam" FontSize="14" Padding="10,7"
                     BorderBrush="#BDC3C7" BorderThickness="1" Margin="0,0,0,14"/>

            <!-- ── Geslacht ───────────────────────────────────────────────────── -->
            <TextBlock Text="Geslacht *" FontSize="13" Foreground="#566573" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <RadioButton x:Name="RbMan"             Content="Man"               GroupName="Geslacht" Margin="0,0,16,0" FontSize="14"/>
                <RadioButton x:Name="RbVrouw"           Content="Vrouw"             GroupName="Geslacht" Margin="0,0,16,0" FontSize="14"/>
                <RadioButton x:Name="RbOnbekend"        Content="Onbekend"          GroupName="Geslacht" Margin="0,0,16,0" FontSize="14" IsChecked="True"/>
                <RadioButton x:Name="RbNietVanToepassing" Content="Niet van toepassing" GroupName="Geslacht" FontSize="14"/>
            </StackPanel>

            <!-- ── Geboortedatum ─────────────────────────────────────────────── -->
            <TextBlock Text="Geboortedatum *" FontSize="13" Foreground="#566573" Margin="0,0,0,6"/>
            <Calendar x:Name="CalGeboortedatum" SelectionMode="SingleDate" Margin="0,0,0,4"/>
            <TextBlock x:Name="TxtGeselecteerdeDatum" FontSize="13" Foreground="#27AE60"
                       Margin="0,0,0,14"/>

            <!-- ── E-mailadres ────────────────────────────────────────────────── -->
            <TextBlock Text="E-mailadres *" FontSize="13" Foreground="#566573" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtEmail" FontSize="14" Padding="10,7"
                     BorderBrush="#BDC3C7" BorderThickness="1" Margin="0,0,0,14"/>

            <!-- ── GSM ───────────────────────────────────────────────────────── -->
            <TextBlock Text="GSM (optioneel)" FontSize="13" Foreground="#566573" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtGsm" FontSize="14" Padding="10,7"
                     BorderBrush="#BDC3C7" BorderThickness="1" Margin="0,0,0,14"/>

            <!-- ── Notificatievoorkeur ────────────────────────────────────────── -->
            <TextBlock Text="Notificatievoorkeur *" FontSize="13" Foreground="#566573" Margin="0,0,0,4"/>
            <ComboBox x:Name="CmbNotificaties" FontSize="14" Padding="8,6"
                      BorderBrush="#BDC3C7" BorderThickness="1"
                      Margin="0,0,0,14" Width="200" HorizontalAlignment="Left"/>

            <!-- ── Profielfoto ─────────────────────────────────────────────────── -->
            <TextBlock Text="Profielfoto (optioneel)" FontSize="13" Foreground="#566573" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="BtnKiesFoto" Content="Kies afbeelding…"
                        Click="BtnKiesFoto_Click"
                        Padding="14,7"
                        Background="#566573" Foreground="White"
                        BorderThickness="0" FontSize="13" Cursor="Hand"/>
            </StackPanel>
            <!-- Voorbeeldweergave van de gekozen foto -->
            <Image x:Name="ImgFotoPreview" Width="100" Height="100"
                   Stretch="UniformToFill" HorizontalAlignment="Left"
                   Margin="0,0,0,20" Visibility="Collapsed"/>

            <!-- Foutmelding — nooit een MessageBox -->
            <TextBlock x:Name="TxtFout" Foreground="#C0392B" FontSize="13"
                       TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed"/>

            <!-- Opslaan-knop -->
            <Button x:Name="BtnOpslaan" Content="Opslaan"
                    Click="BtnOpslaan_Click"
                    HorizontalAlignment="Left" Padding="20,10"
                    Background="#2980B9" Foreground="White"
                    BorderThickness="0" FontSize="15" Cursor="Hand"/>

        </StackPanel>
    </ScrollViewer>
</Page>
