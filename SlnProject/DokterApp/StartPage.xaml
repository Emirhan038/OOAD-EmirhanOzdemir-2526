<Page x:Class="DokterApp.StartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Start">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="48,48,48,32" MaxWidth="680" HorizontalAlignment="Left">

            <TextBlock Text="Welkom bij het Artsendashboard"
                       FontSize="26" FontWeight="Bold" Foreground="#2C3E50"
                       Margin="0,0,0,16" TextWrapping="Wrap"/>

            <TextBlock FontSize="14" Foreground="#566573" LineHeight="26"
                       TextWrapping="Wrap" Margin="0,0,0,24">
                Via dit portaal kunnen artsen hun praktijk beheren.
                Log in met uw artsaccount om aan de slag te gaan.
            </TextBlock>

            <!-- Functionaliteitsoverzicht -->
            <TextBlock Text="Wat kunt u doen?" FontSize="16" FontWeight="SemiBold"
                       Foreground="#2C3E50" Margin="0,0,0,12"/>

            <Border Background="#EBF5FB" CornerRadius="6" Padding="20,16" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Patiënten" FontSize="14" FontWeight="Bold"
                               Foreground="#2980B9" Margin="0,0,0,4"/>
                    <TextBlock FontSize="13" Foreground="#566573" TextWrapping="Wrap"
                               LineHeight="22">
                        Bekijk alle patiënten, voeg nieuwe patiënten toe en beheer
                        hun gegevens (naam, geboortedatum, notificatievoorkeuren, foto).
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Background="#EAFAF1" CornerRadius="6" Padding="20,16" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Afspraken" FontSize="14" FontWeight="Bold"
                               Foreground="#27AE60" Margin="0,0,0,4"/>
                    <TextBlock FontSize="13" Foreground="#566573" TextWrapping="Wrap"
                               LineHeight="22">
                        Bekijk, plan en beheer afspraken. U kunt afspraken aanmaken,
                        wijzigen of annuleren.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Instructie -->
            <TextBlock FontSize="14" Foreground="#566573" TextWrapping="Wrap" LineHeight="24">
                Klik op <Bold>Inloggen</Bold> in het linkermenu om te beginnen.
                Gebruik uw e-mailadres en wachtwoord om toegang te krijgen.
            </TextBlock>

        </StackPanel>
    </ScrollViewer>
</Page>
