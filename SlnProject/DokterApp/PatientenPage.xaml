<Page x:Class="DokterApp.PatientenPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Patiënten">

    <!--
        PatientenPage werkt als shell: het SubFrame toont een van de vier
        subpagina's (overzicht / details / formulier / verwijderen).
        Navigatie wordt aangestuurd via NavigeerNaar() in code-behind.
    -->
    <Frame x:Name="SubFrame" NavigationUIVisibility="Hidden"/>
</Page>
