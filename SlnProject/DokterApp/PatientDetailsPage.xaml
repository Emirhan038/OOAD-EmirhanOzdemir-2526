<Page x:Class="DokterApp.PatientDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Patiënt – Details">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,24,40,32" MaxWidth="640" HorizontalAlignment="Left">

            <!-- Terug-knop -->
            <Button x:Name="BtnTerug" Content="← Terug naar overzicht"
                    Click="BtnTerug_Click"
                    HorizontalAlignment="Left"
                    Padding="14,7" Margin="0,0,0,20"
                    Background="#7F8C8D" Foreground="White"
                    BorderThickness="0" FontSize="13" Cursor="Hand"/>

            <!-- Paginatitel met naam van de patiënt -->
            <TextBlock x:Name="TxtTitel" FontSize="22" FontWeight="Bold"
                       Foreground="#2C3E50" Margin="0,0,0,20" TextWrapping="Wrap"/>

            <!-- Profielfoto of placeholder -->
            <Border x:Name="BorderPlaceholderDetail"
                    Width="120" Height="120" CornerRadius="60"
                    Background="#AEB6BF" HorizontalAlignment="Left"
                    Margin="0,0,0,20">
                <TextBlock Text="?" Foreground="White" FontSize="48"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Image x:Name="ImgFoto" Width="120" Height="120"
                   Stretch="UniformToFill" HorizontalAlignment="Left"
                   Margin="0,0,0,20" Visibility="Collapsed">
                <Image.Clip>
                    <EllipseGeometry Center="60,60" RadiusX="60" RadiusY="60"/>
                </Image.Clip>
            </Image>

            <!-- Detailvelden (gelabeld, read-only via TextBlock) -->
            <TextBlock Text="Voornaam" FontSize="12" Foreground="#7F8C8D" Margin="0,0,0,2"/>
            <TextBlock x:Name="TxtVoornaam" FontSize="15" Foreground="#2C3E50" Margin="0,0,0,12"/>

            <TextBlock Text="Achternaam" FontSize="12" Foreground="#7F8C8D" Margin="0,0,0,2"/>
            <TextBlock x:Name="TxtAchternaam" FontSize="15" Foreground="#2C3E50" Margin="0,0,0,12"/>

            <TextBlock Text="Geslacht" FontSize="12" Foreground="#7F8C8D" Margin="0,0,0,2"/>
            <TextBlock x:Name="TxtGeslacht" FontSize="15" Foreground="#2C3E50" Margin="0,0,0,12"/>

            <TextBlock Text="Geboortedatum" FontSize="12" Foreground="#7F8C8D" Margin="0,0,0,2"/>
            <TextBlock x:Name="TxtGeboortedatum" FontSize="15" Foreground="#2C3E50" Margin="0,0,0,12"/>

            <TextBlock Text="E-mailadres" FontSize="12" Foreground="#7F8C8D" Margin="0,0,0,2"/>
            <TextBlock x:Name="TxtEmail" FontSize="15" Foreground="#2C3E50" Margin="0,0,0,12"/>

            <TextBlock Text="GSM" FontSize="12" Foreground="#7F8C8D" Margin="0,0,0,2"/>
            <TextBlock x:Name="TxtGsm" FontSize="15" Foreground="#2C3E50" Margin="0,0,0,12"/>

            <TextBlock Text="Notificatievoorkeur" FontSize="12" Foreground="#7F8C8D" Margin="0,0,0,2"/>
            <TextBlock x:Name="TxtNotificaties" FontSize="15" Foreground="#2C3E50" Margin="0,0,0,12"/>

        </StackPanel>
    </ScrollViewer>
</Page>
