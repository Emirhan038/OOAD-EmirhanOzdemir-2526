<Window x:Class="PatientApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dokterspraktijk — Patiëntenportaal" Height="620" Width="1050"
        MinHeight="500" MinWidth="800">

    <Window.Resources>
        <!-- Stijl voor de knoppen in het linkermenu -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background"              Value="Transparent"/>
            <Setter Property="Foreground"              Value="White"/>
            <Setter Property="BorderThickness"         Value="0"/>
            <Setter Property="FontSize"                Value="14"/>
            <Setter Property="Padding"                 Value="16,13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor"                  Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Brd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="#1A6B5A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#8DAFA0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ LINKERMENU ═══════════════════════════════════════════════════ -->
        <Border Grid.Column="0" Background="#1E8449">
            <StackPanel>
                <!-- Apptitel bovenaan het menu -->
                <TextBlock Text="Dokterspraktijk" Foreground="White"
                           FontSize="16" FontWeight="Bold"
                           Margin="16,24,16,32" TextWrapping="Wrap"
                           TextAlignment="Center"/>

                <!-- Altijd beschikbare knoppen -->
                <Button x:Name="BtnStart"    Content="▸  Start"    Click="BtnStart_Click"
                        Style="{StaticResource MenuButtonStyle}"/>
                <Button x:Name="BtnInloggen" Content="▸  Inloggen" Click="BtnInloggen_Click"
                        Style="{StaticResource MenuButtonStyle}"/>

                <!-- Scheidingslijn -->
                <Border Height="1" Background="#27AE60" Margin="16,8"/>

                <!-- App-specifieke knoppen — uitgeschakeld tot inloggen -->
                <Button x:Name="BtnAfspraken" Content="▸  Afspraken" Click="BtnAfspraken_Click"
                        Style="{StaticResource MenuButtonStyle}" IsEnabled="False"/>
                <Button x:Name="BtnProfiel"   Content="▸  Profiel"   Click="BtnProfiel_Click"
                        Style="{StaticResource MenuButtonStyle}" IsEnabled="False"/>
            </StackPanel>
        </Border>

        <!-- ═══ RECHTERGEDEELTE ══════════════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Topbalk: naam + profielfoto rechts -->
            <Border Grid.Row="0" Background="#F0F3F4"
                    BorderBrush="#D5D8DC" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,20,0">

                    <TextBlock x:Name="TxtGebruikerNaam" Text="niet ingelogd"
                               VerticalAlignment="Center" Margin="0,0,12,0"
                               FontSize="14" Foreground="#155C33"/>

                    <!-- Placeholder: grijs rondje met vraagteken -->
                    <Border x:Name="BorderPlaceholder" Width="44" Height="44"
                            Background="#AEB6BF" CornerRadius="22">
                        <TextBlock Text="?" Foreground="White" FontSize="22"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Profielfoto — verborgen zolang er geen foto is -->
                    <Image x:Name="ImgProfiel" Width="44" Height="44"
                           Stretch="UniformToFill" Visibility="Collapsed">
                        <Image.Clip>
                            <EllipseGeometry Center="22,22" RadiusX="22" RadiusY="22"/>
                        </Image.Clip>
                    </Image>

                </StackPanel>
            </Border>

            <!-- Inhoudsframe — toont de actieve pagina -->
            <Frame x:Name="MainFrame" Grid.Row="1"
                   NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Window>
