<Page x:Class="WpfControlsOefenblad.Exercises.AnimalSounds"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:WpfControlsOefenblad.Exercises"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MatchImages">

    <Grid Background="#eeeeee">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="280"/>
        </Grid.RowDefinitions>

        <Frame x:Name="fraAssignment" Grid.Row="0" />
        <Border Background="White" Grid.Row="1">
            <!-- HIERONDER BEGINT XAML VAN DE OEFENING -->
            <WrapPanel Margin="20" VerticalAlignment="Center">
                <Image Source="/dieren afbeeldingen/cat.png"
                       Width="100" Height="100" Margin="10"
                       Tag="cat.wav"
                       MouseEnter="Image_MouseEnter"/>
                <Image Source="/dieren afbeeldingen/chicken.png"
                       Width="100" Height="100" Margin="10"
                       Tag="chicken.wav"
                       MouseEnter="Image_MouseEnter"/>
                <Image Source="/dieren afbeeldingen/cow.png"
                       Width="100" Height="100" Margin="10"
                       Tag="cow.wav"
                       MouseEnter="Image_MouseEnter"/>
                <Image Source="/dieren afbeeldingen/horse.png"
                       Width="100" Height="100" Margin="10"
                       Tag="horse.wav"
                       MouseEnter="Image_MouseEnter"/>
            </WrapPanel>
        </Border>
    </Grid>
</Page>