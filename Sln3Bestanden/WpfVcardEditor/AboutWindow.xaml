<Window x:Class="WpfVcardEditor.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About vCard Editor"
        Height="300" Width="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="30,20">

        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBlock Text="Odisee"
                       FontSize="40" FontWeight="Bold"
                       Foreground="#1B3A6B"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="DE CO-HOGESCHOOL"
                       FontSize="11" Foreground="#1B3A6B"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <StackPanel Margin="0,0,0,25">
            <TextBlock Margin="0,2">
                <Run FontWeight="Bold">Gemaakt door: </Run>
                <Run>Emirhan Ozdemir</Run>
            </TextBlock>
            <TextBlock Margin="0,2">
                <Run FontWeight="Bold">Vak: </Run>
                <Run>OO Application Development</Run>
            </TextBlock>
            <TextBlock Margin="0,2">
                <Run FontWeight="Bold">Academiejaar: </Run>
                <Run>2025-2026</Run>
            </TextBlock>
        </StackPanel>

        <!-- Sluitknop -->
        <Button Content="SLUITEN"
                Width="100"
                HorizontalAlignment="Center"
                Click="btnClose_Click"/>
    </StackPanel>
</Window>
